{
  "name": "cotoleti-app",
  "main": "server/worker.js",
  "compatibility_date": "2025-04-07",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SKY", "class_name": "Sky" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sky"] }]
}
